@page "/movies"
@using MovieMatch.Models
@using MovieMatch.Services
@inject MovieService MovieService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Movies - Rate Movies</PageTitle>

<div class="movie-swipe-container">
    @if (currentMovie != null)
    {
        <div class="movie-card">
            <div class="movie-poster">
                @if (!string.IsNullOrEmpty(currentMovie.ImageUrl))
                {
                    <img src="@currentMovie.ImageUrl" alt="@currentMovie.Title" />
                }
                else
                {
                    <div class="no-poster">No Image Available</div>
                }
            </div>
            <div class="movie-info">
                <h2>@currentMovie.Title</h2>
                <div class="movie-meta">
                    <span class="year">@currentMovie.Year</span>
                    <span class="genre">@currentMovie.Genre</span>
                    <span class="rating">⭐ @currentMovie.Rating</span>
                </div>
                <p class="description">@currentMovie.Description</p>
            </div>
            <div class="movie-actions">
                <button class="btn btn-dislike" @onclick="() => RateMovie(false)">
                    <span class="bi bi-x-circle"></span> Dislike
                </button>
                <button class="btn btn-like" @onclick="() => RateMovie(true)">
                    <span class="bi bi-heart-fill"></span> Like
                </button>
            </div>
        </div>
    }
    else if (loading)
    {
        <div class="loading">
            <p>Loading movies...</p>
        </div>
    }
    else
    {
        <div class="no-movies">
            <h3>No more movies to rate!</h3>
            <p>You've rated all available movies.</p>
            <a href="/connections" class="btn btn-primary">Connect with friends</a>
        </div>
    }
</div>

<style>
    .movie-swipe-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
    }

    .movie-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .movie-poster {
        width: 100%;
        height: 400px;
        overflow: hidden;
        background: #f0f0f0;
    }

    .movie-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .no-poster {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #999;
        font-size: 1.2rem;
    }

    .movie-info {
        padding: 20px;
    }

    .movie-info h2 {
        margin: 0 0 10px 0;
        font-size: 1.8rem;
        color: #333;
    }

    .movie-meta {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }

    .movie-meta span {
        background: #f0f0f0;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.9rem;
        color: #666;
    }

    .description {
        color: #666;
        line-height: 1.6;
    }

    .movie-actions {
        display: flex;
        gap: 10px;
        padding: 20px;
        justify-content: space-between;
    }

    .movie-actions .btn {
        flex: 1;
        padding: 15px;
        font-size: 1.1rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-like {
        background: #4CAF50;
        color: white;
    }

    .btn-like:hover {
        background: #45a049;
        transform: scale(1.05);
    }

    .btn-dislike {
        background: #f44336;
        color: white;
    }

    .btn-dislike:hover {
        background: #da190b;
        transform: scale(1.05);
    }

    .loading, .no-movies {
        text-align: center;
        padding: 60px 20px;
    }

    .no-movies h3 {
        color: #333;
        margin-bottom: 10px;
    }

    .no-movies p {
        color: #666;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .movie-poster {
            height: 300px;
        }

        .movie-info h2 {
            font-size: 1.5rem;
        }
    }
</style>

@code {
    private Movie? currentMovie;
    private bool loading = true;
    private int currentUserId = 1; // Demo user

    protected override async Task OnInitializedAsync()
    {
        await LoadNextMovie();
    }

    private async Task LoadNextMovie()
    {
        loading = true;
        var unratedMovies = await MovieService.GetUnratedMoviesForUserAsync(currentUserId);
        currentMovie = unratedMovies.FirstOrDefault();
        loading = false;
    }

    private async Task RateMovie(bool isLiked)
    {
        if (currentMovie != null)
        {
            await MovieService.RateMovieAsync(currentUserId, currentMovie.Id, isLiked);
            await LoadNextMovie();
        }
    }
}
