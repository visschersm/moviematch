@page "/"

<PageTitle>MovieMatch - Home</PageTitle>

<div class="home-container">
    <div class="hero">
        <h1>🎬 Welcome to MovieMatch</h1>
        <p class="tagline">Discover movies you love and connect with friends who share your taste!</p>
    </div>

    <div class="features">
        <div class="feature-card">
            <span class="bi bi-film feature-icon"></span>
            <h3>Rate Movies</h3>
            <p>Swipe through movies and rate them with a simple like or dislike.</p>
            <a href="/movies" class="btn btn-primary">Start Rating</a>
        </div>

        <div class="feature-card">
            <span class="bi bi-people feature-icon"></span>
            <h3>Connect</h3>
            <p>Connect with friends to see what movies you both enjoy.</p>
            <a href="/connections" class="btn btn-primary">Manage Connections</a>
        </div>

        <div class="feature-card">
            <span class="bi bi-heart feature-icon"></span>
            <h3>Find Matches</h3>
            <p>Discover movies that you and your friends both like.</p>
            <a href="/matches" class="btn btn-primary">View Matches</a>
        </div>
    </div>

    <div class="how-it-works">
        <h2>How It Works</h2>
        <ol>
            <li>
                <strong>Rate Movies:</strong> Browse through our collection and indicate whether you like or dislike each movie.
            </li>
            <li>
                <strong>Connect with Friends:</strong> Add friends to see their movie preferences.
            </li>
            <li>
                <strong>Find Common Ground:</strong> See a list of movies you both enjoyed for your next movie night!
            </li>
        </ol>
    </div>
</div>

<style>
    .home-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .hero {
        text-align: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        margin-bottom: 40px;
    }

    .hero h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .tagline {
        font-size: 1.2rem;
        opacity: 0.95;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        margin-bottom: 50px;
    }

    .feature-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    .feature-icon {
        font-size: 3rem;
        color: #667eea;
        margin-bottom: 15px;
    }

    .feature-card h3 {
        margin-bottom: 12px;
        color: #333;
    }

    .feature-card p {
        color: #666;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .btn-primary {
        display: inline-block;
        padding: 12px 24px;
        background: #4CAF50;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        transition: background 0.2s ease;
        font-weight: 500;
    }

    .btn-primary:hover {
        background: #45a049;
    }

    .how-it-works {
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .how-it-works h2 {
        text-align: center;
        margin-bottom: 30px;
        color: #333;
    }

    .how-it-works ol {
        max-width: 700px;
        margin: 0 auto;
        padding-left: 20px;
    }

    .how-it-works li {
        margin-bottom: 20px;
        line-height: 1.6;
        color: #555;
    }

    .how-it-works strong {
        color: #333;
    }

    @@media (max-width: 768px) {
        .hero h1 {
            font-size: 2rem;
        }

        .hero {
            padding: 40px 20px;
        }

        .features {
            grid-template-columns: 1fr;
        }

        .how-it-works {
            padding: 25px;
        }
    }
</style>

